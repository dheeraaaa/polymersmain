{
  "info": {"name":"StockAI Backend API - Full E2E","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json","description":"Run the E2E Flow folder in order. It creates unique test data and validates the complete implemented backend flow."},
  "event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["if (!pm.collectionVariables.get('runId')) pm.collectionVariables.set('runId', Date.now().toString());"]}}],
  "auth":{"type":"bearer","bearer":[{"key":"token","value":"{{adminToken}}","type":"string"}]},
  "variable":[
    {"key":"baseUrl","value":"http://localhost:4000/api/v1"},{"key":"adminEmail","value":"admin@stockai.com"},{"key":"adminPassword","value":"Admin@123456789"},{"key":"adminToken","value":""},{"key":"runId","value":""},{"key":"sourceWarehouseId","value":""},{"key":"destinationWarehouseId","value":""},{"key":"warehouseUserId","value":""},{"key":"materialId","value":""},{"key":"productId","value":""},{"key":"supplierId","value":""},{"key":"purchaseOrderId","value":""},{"key":"rawBatchId","value":""},{"key":"productionRunId","value":""},{"key":"finishedBatchId","value":""},{"key":"transferId","value":""},{"key":"barcode","value":""}
  ],
  "item":[{"name":"E2E Flow - run in this order","item":[
    {"name":"01 Health","request":{"auth":{"type":"noauth"},"method":"GET","url":"{{baseUrl}}/health"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Health is OK',()=>pm.response.to.have.status(200));"]}}]},
    {"name":"02 Bootstrap admin if database is fresh","request":{"auth":{"type":"noauth"},"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"Super Admin\",\"email\":\"{{adminEmail}}\",\"password\":\"{{adminPassword}}\"}"},"url":"{{baseUrl}}/auth/register"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Bootstrap either creates admin or is already closed',()=>pm.expect([201,403]).to.include(pm.response.code));"]}}]},
    {"name":"03 Login super admin","request":{"auth":{"type":"noauth"},"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{adminEmail}}\",\"password\":\"{{adminPassword}}\"}"},"url":"{{baseUrl}}/auth/login"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Admin login',()=>pm.response.to.have.status(200));","pm.collectionVariables.set('adminToken',pm.response.json().accessToken);"]}}]},
    {"name":"04 Create source warehouse","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"E2E Source {{runId}}\",\"unitId\":\"UNIT-1\",\"type\":\"RAW_MATERIAL\",\"address\":\"Test source\",\"capacity\":50000,\"capacityUnit\":\"KG\"}"},"url":"{{baseUrl}}/warehouses"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Source warehouse created',()=>pm.response.to.have.status(201));","pm.collectionVariables.set('sourceWarehouseId',pm.response.json().id);"]}}]},
    {"name":"05 Create destination warehouse","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"E2E Destination {{runId}}\",\"unitId\":\"UNIT-1\",\"type\":\"FINISHED_GOODS\",\"address\":\"Test destination\",\"capacity\":50000,\"capacityUnit\":\"KG\"}"},"url":"{{baseUrl}}/warehouses"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Destination warehouse created',()=>pm.response.to.have.status(201));","pm.collectionVariables.set('destinationWarehouseId',pm.response.json().id);"]}}]},
    {"name":"06 Create warehouse executive","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"E2E Warehouse {{runId}}\",\"email\":\"warehouse.{{runId}}@stockai.test\",\"password\":\"WarehousePass-2026\",\"role\":\"WAREHOUSE_EXECUTIVE\",\"unitId\":\"UNIT-1\",\"warehouseIds\":[\"{{sourceWarehouseId}}\",\"{{destinationWarehouseId}}\"]}"},"url":"{{baseUrl}}/users"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Warehouse user created',()=>pm.response.to.have.status(201));","pm.collectionVariables.set('warehouseUserId',pm.response.json().id);"]}}]},
    {"name":"07 List users","request":{"method":"GET","url":"{{baseUrl}}/users"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('User administration list works',()=>pm.response.to.have.status(200));"]}}]},
    {"name":"08 Create material","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"sku\":\"RM-{{runId}}\",\"name\":\"E2E Polypropylene\",\"category\":\"RAW_MATERIAL\",\"unit\":\"KG\",\"reorderPoint\":500,\"leadTimeDays\":7}"},"url":"{{baseUrl}}/materials"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Material created',()=>pm.response.to.have.status(201));","pm.collectionVariables.set('materialId',pm.response.json().id);"]}}]},
    {"name":"09 Create product","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"sku\":\"FG-{{runId}}\",\"name\":\"E2E Finished Product\",\"category\":\"FINISHED_GOOD\",\"unit\":\"PCS\",\"reorderPoint\":100}"},"url":"{{baseUrl}}/products"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Product created',()=>pm.response.to.have.status(201));","pm.collectionVariables.set('productId',pm.response.json().id);"]}}]},
    {"name":"10 Create supplier","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"E2E Supplier {{runId}}\",\"contactName\":\"Test Contact\",\"email\":\"supplier.{{runId}}@test.com\",\"phone\":\"9876543210\",\"leadTimeDays\":7}"},"url":"{{baseUrl}}/suppliers"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Supplier created',()=>pm.response.to.have.status(201));","pm.collectionVariables.set('supplierId',pm.response.json().id);"]}}]},
    {"name":"11 Create purchase order","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"supplierId\":\"{{supplierId}}\",\"lines\":[{\"materialId\":\"{{materialId}}\",\"quantity\":1000,\"unitPrice\":80}]}"},"url":"{{baseUrl}}/purchase-orders"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Purchase order created',()=>pm.response.to.have.status(201));","pm.collectionVariables.set('purchaseOrderId',pm.response.json().id);"]}}]},
    {"name":"12 Receive raw batch","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"batchNumber\":\"RAW-{{runId}}\",\"materialId\":\"{{materialId}}\",\"supplierLot\":\"LOT-{{runId}}\",\"warehouseId\":\"{{sourceWarehouseId}}\",\"unitId\":\"UNIT-1\",\"quantity\":1000,\"uom\":\"KG\"}"},"url":"{{baseUrl}}/batches"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Batch received',()=>pm.response.to.have.status(201));","pm.collectionVariables.set('rawBatchId',pm.response.json().id);"]}}]},
    {"name":"13 Generate QR label","request":{"method":"POST","url":"{{baseUrl}}/batches/{{rawBatchId}}/label"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Label generated',()=>pm.response.to.have.status(200));","pm.collectionVariables.set('barcode',pm.response.json().code);"]}}]},
    {"name":"14 Scan QR label","request":{"method":"GET","url":"{{baseUrl}}/scan/{{barcode}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Barcode resolves batch',()=>pm.response.to.have.status(200));","pm.test('Correct batch returned',()=>pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('rawBatchId')));"]}}]},
    {"name":"15 Record passed QC","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"batchId\":\"{{rawBatchId}}\",\"stage\":\"INCOMING\",\"result\":\"PASSED\",\"tests\":[{\"name\":\"MFI\",\"value\":\"12.4\",\"unit\":\"g/10 min\",\"withinSpec\":true}],\"notes\":\"E2E pass\"}"},"url":"{{baseUrl}}/quality-inspections"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Quality record created',()=>pm.response.to.have.status(201));"]}}]},
    {"name":"16 Release batch","request":{"method":"POST","url":"{{baseUrl}}/batches/{{rawBatchId}}/release"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Batch released',()=>pm.response.to.have.status(200));","pm.test('Batch available',()=>pm.expect(pm.response.json().status).to.eql('AVAILABLE'));"]}}]},
    {"name":"17 Start production run","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"productId\":\"{{productId}}\",\"unitId\":\"UNIT-1\",\"warehouseId\":\"{{sourceWarehouseId}}\",\"consumptions\":[{\"batchId\":\"{{rawBatchId}}\",\"quantity\":500}]}"},"url":"{{baseUrl}}/production-runs"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Production started',()=>pm.response.to.have.status(201));","pm.collectionVariables.set('productionRunId',pm.response.json().id);"]}}]},
    {"name":"18 Complete production run","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"outputQuantity\":95,\"outputBatchNumber\":\"FG-{{runId}}\",\"outputUom\":\"PCS\"}"},"url":"{{baseUrl}}/production-runs/{{productionRunId}}/complete"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Production completed',()=>pm.response.to.have.status(200));","pm.collectionVariables.set('finishedBatchId',pm.response.json().outputBatchId);"]}}]},
    {"name":"19 Create transfer","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"batchId\":\"{{finishedBatchId}}\",\"fromWarehouseId\":\"{{sourceWarehouseId}}\",\"toWarehouseId\":\"{{destinationWarehouseId}}\",\"quantity\":50}"},"url":"{{baseUrl}}/transfers"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Transfer created',()=>pm.response.to.have.status(201));","pm.collectionVariables.set('transferId',pm.response.json().id);"]}}]},
    {"name":"20 Approve transfer","request":{"method":"POST","url":"{{baseUrl}}/transfers/{{transferId}}/approve"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Transfer approved',()=>pm.response.to.have.status(200));"]}}]},
    {"name":"21 Receive partial transfer","request":{"method":"POST","url":"{{baseUrl}}/transfers/{{transferId}}/receive"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Transfer received',()=>pm.response.to.have.status(200));","pm.test('Destination batch created',()=>pm.expect(pm.response.json().destinationBatchId).to.be.ok);"]}}]},
    {"name":"22 Reorder recommendations","request":{"method":"GET","url":"{{baseUrl}}/reorder-recommendations"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Recommendations available',()=>pm.response.to.have.status(200));"]}}]},
    {"name":"23 Dashboard summary","request":{"method":"GET","url":"{{baseUrl}}/dashboard/summary"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Full E2E flow completed',()=>pm.response.to.have.status(200));","pm.test('Dashboard has stock state',()=>pm.expect(pm.response.json()).to.have.property('availableStock'));"]}}]}
  ]}]}
